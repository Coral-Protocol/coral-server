{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": "npx/src",
    "outDir": "npx/dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["npx/src/**/*.ts", "npx/src/**/*.tsx"]
}
