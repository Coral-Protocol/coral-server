# Example base image for agents launched under Coral's OpenShellRuntime.
# Copy and adapt for your agent.
#
# Hard requirements (the supervisor refuses to start otherwise):
#   - iproute2        (ip netns / veth setup; supervisor shells out to `ip`)
#   - unprivileged "sandbox" user + group (supervisor drops to this UID)
#   - glibc ≥ 2.38 rootfs (supervisor v0.0.48 is dynamically linked
#     against /lib64/ld-linux-x86-64.so.2 and requires GLIBC_2.38+;
#     debian:trixie / ubuntu:noble / distroless-glibc work, debian:bookworm
#     ships 2.36 and is too old; pure-musl alpine needs a glibc shim)
#   - writable /sandbox and /tmp (declared read_write in generated policy.yaml)
#
# Recommended for full defense-in-depth (supervisor degrades with a
# `CONFIG:DEGRADED [MED]` line if missing, but the container still runs):
#   - nftables        (kernel-level bypass-detection rules inside the netns,
#                      loaded atomically via `nft -f`; without it the OPA
#                      proxy is the sole egress control and direct-TCP
#                      attempts that dodge the proxy succeed. NOTE: supervisor
#                      ≤v0.0.43 used `iptables` instead — bundle that if your
#                      operator runs an older supervisor)
#   - libcap2-bin     (setcap/getcap helpers used during privilege drop)
#   - ca-certificates (HTTPS egress to declared external_hosts through proxy)
#
# Host requirements:
#   - Linux kernel 5.13+ (Landlock; older kernels skip the FS-ACL layer)
#
# Do NOT set ENTRYPOINT — OpenShellRuntime overrides it with the supervisor
# binary. Your [runtimes.openshell].command becomes the inner argv executed
# after the supervisor sets up the sandbox.

FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      iproute2 \
      libcap2-bin \
      ca-certificates \
      nftables \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd -r sandbox \
 && useradd -r -g sandbox -d /sandbox -s /usr/sbin/nologin sandbox \
 && mkdir -p /sandbox \
 && chown sandbox:sandbox /sandbox

# Install your agent here, e.g.:
# COPY --chown=sandbox:sandbox agent/ /sandbox/
# WORKDIR /sandbox
